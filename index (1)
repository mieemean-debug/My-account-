Main Server (server.js)

require('dotenv').config();

const express = require('express');
const mongoose = require('mongoose');
const cors = require('cors');
const multer = require('multer');
const axios = require('axios');

const User = require('./models/User');
const File = require('./models/File');
const Withdraw = require('./models/Withdraw');

const app = express();

app.use(cors());
app.use(express.json());
app.use('/uploads', express.static('uploads'));

mongoose.connect(process.env.MONGO_URI);

const storage = multer.diskStorage({
  destination: function (req, file, cb) {
    cb(null, 'uploads/');
  },
  filename: function (req, file, cb) {
    cb(null, Date.now() + '-' + file.originalname);
  }
});

const upload = multer({ storage });

// FILE SUBMIT
app.post('/upload', upload.single('file'), async (req, res) => {
  try {
    const { telegramId } = req.body;

    const saved = await File.create({
      telegramId,
      fileName: req.file.filename,
      path: req.file.path
    });

    // Send notification to admin
    await axios.post(
      `https://api.telegram.org/bot${process.env.BOT_TOKEN}/sendMessage`,
      {
        chat_id: process.env.ADMIN_ID,
        text: `New file submitted by ${telegramId}`
      }
    );

    res.json({ success: true, data: saved });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

// CREATE USER
app.post('/register', async (req, res) => {
  const { telegramId, username } = req.body;

  let user = await User.findOne({ telegramId });

  if (!user) {
    user = await User.create({ telegramId, username });
  }

  res.json(user);
});

// GET BALANCE
app.get('/balance/:telegramId', async (req, res) => {
  const user = await User.findOne({
    telegramId: req.params.telegramId
  });

  res.json({
    balance: user?.balance || 0
  });
});

// MANUAL BALANCE ADD
app.post('/admin/add-balance', async (req, res) => {
  const { telegramId, amount } = req.body;

  const user = await User.findOne({ telegramId });

  if (!user) {
    return res.json({ error: 'User not found' });
  }

  user.balance += Number(amount);
  await user.save();

  // notify user
  await axios.post(
    `https://api.telegram.org/bot${process.env.BOT_TOKEN}/sendMessage`,
    {
      chat_id: telegramId,
      text: `Balance added: ${amount}`
    }
  );

  res.json({ success: true });
});

// WITHDRAW REQUEST
app.post('/withdraw', async (req, res) => {
  const { telegramId, amount, method, wallet } = req.body;

  const user = await User.findOne({ telegramId });

  if (!user) {
    return res.json({ error: 'User not found' });
  }

  if (user.balance < amount) {
    return res.json({ error: 'Insufficient balance' });
  }

  user.balance -= amount;
  await user.save();

  const withdraw = await Withdraw.create({
    telegramId,
    amount,
    method,
    wallet
  });

  await axios.post(
    `https://api.telegram.org/bot${process.env.BOT_TOKEN}/sendMessage`,
    {
      chat_id: process.env.ADMIN_ID,
      text: `Withdraw Request\nUser: ${telegramId}\nAmount: ${amount}\nMethod: ${method}\nWallet: ${wallet}`
    }
  );

  res.json({ success: true, withdraw });
});

app.listen(process.env.PORT, () => {
  console.log('Server running');
});


